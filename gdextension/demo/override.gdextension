[configuration]
entry_symbol = "override_library_init"
compatibility_minimum = "4.3"

[libraries]
linux.debug.x86_64 = "res://bin/liboverride.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/liboverride.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/liboverride.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/liboverride.linux.template_release.arm64.so"
windows.debug.x86_64 = "res://bin/liboverride.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/liboverride.windows.template_release.x86_64.dll"
macos.debug = "res://bin/liboverride.macos.template_debug.framework"
macos.release = "res://bin/liboverride.macos.template_release.framework"
